# Public settings kept for compatibility with the original template.
NEXT_PUBLIC_APP_ID=
NEXT_PUBLIC_APP_KEY=
NEXT_PUBLIC_API_URL=

# Aliyun OSS settings used to store uploaded mp3/mp4 before ASR.
ALI_OSS_REGION=oss-cn-hangzhou
ALI_OSS_BUCKET=
ALI_OSS_ACCESS_KEY_ID=
ALI_OSS_ACCESS_KEY_SECRET=
ALI_OSS_SIGNED_URL_EXPIRES=3600

# Bailian / DashScope settings.
DASHSCOPE_API_KEY=
DASHSCOPE_ASR_MODEL=paraformer-v2
DASHSCOPE_LLM_MODEL=qwen-plus
DASHSCOPE_ASR_MAX_ATTEMPTS=36
DASHSCOPE_ASR_POLL_INTERVAL_MS=5000
